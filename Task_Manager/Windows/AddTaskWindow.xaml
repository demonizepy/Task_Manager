<Window x:Class="Task_Manager.Windows.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Add_Title}" Width="440"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Add_Id}" VerticalAlignment="Center" Margin="0,0,12,10" />
        <TextBox x:Name="txtId" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="{DynamicResource Add_Description}" VerticalAlignment="Top" Margin="0,3,12,0" />
        <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="1" Height="64"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Add_Button}" IsDefault="True" Margin="0,0,8,0" Click="btnOk_Click" />
            <Button Content="{DynamicResource Btn_Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
