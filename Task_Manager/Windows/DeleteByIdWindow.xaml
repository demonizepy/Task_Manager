<Window x:Class="Task_Manager.Windows.DeleteByIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DeleteIds_Title}" Width="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}"
        Loaded="Window_Loaded">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource DeleteIds_Hint}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="txtIds" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource DeleteIds_Button}" IsDefault="True" Margin="0,0,8,0" Click="btnOk_Click" />
            <Button Content="{DynamicResource Btn_Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
