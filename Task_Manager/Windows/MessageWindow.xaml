<Window x:Class="Task_Manager.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Title}" Width="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtIcon" FontFamily="Segoe MDL2 Assets" FontSize="26"
                   VerticalAlignment="Top" Margin="0,0,14,0" />
        <TextBlock x:Name="txtMessage" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnYes" Content="{DynamicResource Btn_Yes}"
                    Margin="0,0,8,0" Click="btnYes_Click" />
            <Button x:Name="btnNo" Content="{DynamicResource Btn_No}" />
            <Button x:Name="btnOk" Content="{DynamicResource Btn_Ok}"
                    Click="btnYes_Click" />
        </StackPanel>
    </Grid>
</Window>
