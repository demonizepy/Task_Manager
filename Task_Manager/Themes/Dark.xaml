<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBackground" Color="#252526" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="LineBrush" Color="#3A3A3D" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#55555A" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#3E3E42" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#505056" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#264F78" />
    <SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="AlternatingRowBackground" Color="#29292B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E0A526" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F1707B" />

</ResourceDictionary>
