<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="LineBrush" Color="#DADADA" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2463B4" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#CCE0F7" />
    <SolidColorBrush x:Key="SelectionForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#EAEAEA" />
    <SolidColorBrush x:Key="AlternatingRowBackground" Color="#F8F8F8" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C2C2" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C4314B" />

</ResourceDictionary>
